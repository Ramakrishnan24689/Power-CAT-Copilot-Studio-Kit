kind: AdaptiveDialog
modelDescription: |-
  Purpose: Create a new ServiceNow incident by collecting required incident details and submitting it to ServiceNow.

  Use when user asks:

  To create / raise / log / report a ServiceNow incident or ticket

  To submit a new IT helpdesk issue

  To open a ticket for a problem they are facing

  Examples (user utterances):

  “Create a ServiceNow incident”

  “Raise a ticket for VPN issue”

  “Log an incident for laptop not starting”

  “Report an issue with Outlook”

  “I want to open a helpdesk ticket”

  “Submit a ServiceNow incident for printer problem”

  “Can you create an incident for me?”

  “Log a ticket for password reset issue”
beginDialog:
  kind: OnRecognizedIntent
  id: main
  intent: {}
  actions:
    - kind: AdaptiveCardPrompt
      id: yVdjDu
      card: |-
        {
          "type": "AdaptiveCard",
          "$schema": "https://adaptivecards.io/schemas/adaptive-card.json",
          "version": "1.5",
          "body": [
            {
              "type": "TextBlock",
              "text": "Create a ServiceNow Incident",
              "weight": "Bolder",
              "size": "Large",
              "wrap": true
            },
            {
              "type": "TextBlock",
              "text": "Provide the incident details below. Impact and urgency help determine the priority of the incident.",
              "isSubtle": true,
              "wrap": true,
              "spacing": "Small"
            },
            {
              "type": "Container",
              "style": "default",
              "spacing": "Medium",
              "items": [
                {
                  "type": "Input.Text",
                  "id": "short_description",
                  "label": "Short description",
                  "placeholder": "Example: VPN not connecting on laptop",
                  "isRequired": true,
                  "errorMessage": "Short description is required.",
                  "maxLength": 160
                },
                {
                  "type": "Input.Text",
                  "id": "description",
                  "label": "Description",
                  "placeholder": "Describe the issue in detail. Include error messages, steps tried, and when it started.",
                  "isMultiline": true,
                  "isRequired": true,
                  "errorMessage": "Description is required.",
                  "maxLength": 2000
                }
              ]
            },
            {
              "type": "TextBlock",
              "text": "Business impact",
              "weight": "Bolder",
              "wrap": true,
              "spacing": "Medium"
            },
            {
              "type": "TextBlock",
              "text": "Impact and urgency are standard ServiceNow fields used to calculate priority.",
              "isSubtle": true,
              "wrap": true,
              "spacing": "Small"
            },
            {
              "type": "ColumnSet",
              "spacing": "Medium",
              "columns": [
                {
                  "type": "Column",
                  "width": "stretch",
                  "items": [
                    {
                      "type": "Input.ChoiceSet",
                      "id": "impact",
                      "label": "Impact",
                      "isRequired": true,
                      "errorMessage": "Impact is required.",
                      "value": "3",
                      "choices": [
                        {
                          "title": "1 - High (Business-wide impact)",
                          "value": "1"
                        },
                        {
                          "title": "2 - Medium (Department / group impact)",
                          "value": "2"
                        },
                        {
                          "title": "3 - Low (Single user / minor impact)",
                          "value": "3"
                        }
                      ]
                    }
                  ]
                },
                {
                  "type": "Column",
                  "width": "stretch",
                  "items": [
                    {
                      "type": "Input.ChoiceSet",
                      "id": "urgency",
                      "label": "Urgency",
                      "isRequired": true,
                      "errorMessage": "Urgency is required.",
                      "value": "3",
                      "choices": [
                        {
                          "title": "1 - High (Immediate attention required)",
                          "value": "1"
                        },
                        {
                          "title": "2 - Medium (Needs attention soon)",
                          "value": "2"
                        },
                        {
                          "title": "3 - Low (Can be addressed later)",
                          "value": "3"
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "type": "TextBlock",
              "text": "Note: Priority will be calculated automatically in ServiceNow based on Impact and Urgency.",
              "isSubtle": true,
              "wrap": true,
              "spacing": "Medium"
            }
          ],
          "actions": [
            {
              "type": "Action.Submit",
              "title": "Create incident",
              "data": {
                "action": "createIncident"
              }
            },
            {
              "type": "Action.Submit",
              "title": "Cancel",
              "associatedInputs": "none",
              "data": {
                "action": "cancelIncident"
              }
            }
          ]
        }
      output:
        binding:
          action: Topic.action
          actionSubmitId: Topic.actionSubmitId
          description: Topic.description
          impact: Topic.impact
          short_description: Topic.short_description
          urgency: Topic.urgency

      outputType:
        properties:
          action: String
          actionSubmitId: String
          description: String
          impact: String
          short_description: String
          urgency: String

