          "$schema": "https://adaptivecards.io/schemas/adaptive-card.json",
          "version": "1.5",
          "body": [
            {
              "type": "TextBlock",
              "text": "Update / Resolve a ServiceNow Incident",
              "weight": "Bolder",
              "size": "Large",
              "wrap": true
            },
            {
              "type": "TextBlock",
              "text": "Provide the Incident Number, choose the target State and Resolution Code, and enter Resolution Notes. All fields are required.",
              "isSubtle": true,
              "wrap": true,
              "spacing": "Small"
            },
            {
              "type": "Input.Text",
              "id": "incidentNumber",
              "label": "Incident Number",
              "placeholder": "Example: INC0010002",
              "isRequired": true,
              "errorMessage": "Incident Number is required (example: INC0010002).",
              "maxLength": 20
            },
            {
              "type": "Input.ChoiceSet",
              "id": "targetState",
              "label": "State",
              "isRequired": true,
              "errorMessage": "Please select a State.",
              "value": "6",
              "choices": [
                {
                  "title": "In Progress",
                  "value": "2"
                },
                {
                  "title": "On Hold",
                  "value": "3"
                },
                {
                  "title": "Resolved",
                  "value": "6"
                },
                {
                  "title": "Closed",
                  "value": "7"
                },
                {
                  "title": "Canceled",
                  "value": "8"
                }
              ]
            },
            {
              "type": "Input.ChoiceSet",
              "id": "resolutionCode",
              "label": "Resolution Code",
              "isRequired": true,
              "errorMessage": "Please select a Resolution Code.",
              "choices": [
                {
                  "title": "Duplicate",
                  "value": "Duplicate"
                },
                {
                  "title": "No resolution provided",
                  "value": "No resolution provided"
                },
                {
                  "title": "Resolved by caller",
                  "value": "Resolved by caller"
                },
                {
                  "title": "Resolved by change",
                  "value": "Resolved by change"
                },
                {
                  "title": "Resolved by problem",
                  "value": "Resolved by problem"
                },
                {
                  "title": "Resolved by request",
                  "value": "Resolved by request"
                },
                {
                  "title": "Solution provided",
                  "value": "Solution provided"
                },
                {
                  "title": "Workaround provided",
                  "value": "Workaround provided"
                }
              ]
            },
            {
              "type": "Input.Text",
              "id": "resolutionNotes",
              "label": "Resolution Notes",
              "placeholder": "Example: Rebooted device and confirmed connectivity restored. User validated the fix.",
              "isMultiline": true,
              "isRequired": true,
              "errorMessage": "Resolution Notes are required.",
              "maxLength": 2000
            },
            {
              "type": "TextBlock",
              "text": "Next: I'll find the Incident and ask for your confirmation before updating ServiceNow.",
              "isSubtle": true,
              "wrap": true,
              "spacing": "Medium"
            }
          ],
          "actions": [
            {
              "type": "Action.Submit",
              "title": "Fetch and Continue",
              "data": {
                "action": "reviewIncidentUpdate"
              }
            }
          ]
        }
      output:
        binding:
          action: Topic.action
          actionSubmitId: Topic.actionSubmitId
          incidentNumber: Topic.incidentNumber
          resolutionCode: Topic.resolutionCode
          resolutionNotes: Topic.resolutionNotes
          targetState: Topic.targetState

