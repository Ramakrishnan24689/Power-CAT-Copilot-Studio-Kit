    - kind: ConditionGroup
      id: conditionGroup_xDK2rm
      conditions:
        - id: conditionItem_9hgPEA
          condition: =CountRows(Topic.varResponseUserIncidents.result)>0
          displayName: Incidents found?
          actions:
            - kind: SendActivity
              id: sendActivity_Vq7Eg1
              activity: |-
                {"Recent ServiceNow incident(s) of " & System.User.DisplayName &
                ":<br /><br />" &

                Concat(
                Topic.varResponseUserIncidents.result,

                "<b>" & number & "</b>" &
                "<br />" &

                "<b>State:</b> " &
                Switch(
                Text(state),
                "1", "New",
                "2", "In Progress",
                "3", "On Hold",
                "6", "Resolved",
                "7", "Closed",
                "8", "Canceled",
                "Unknown"
                ) &
                "<br />" &

                "<b>Priority:</b> " &
                Switch(
                Text(priority),
                "1", "1 - Critical",
                "2", "2 - High",
                "3", "3 - Moderate",
                "4", "4 - Low",
                "5", "5 - Planning",
                "Unknown"
                ) &
                "<br />" &

                "<b>Short description:</b> " & Coalesce(short_description, "N/A") &
                "<br />" &

                "<b>Created on:</b> " & Coalesce(sys_created_on, "N/A") &
                "<br />" &

                "<b>Last updated:</b> " & Coalesce(sys_updated_on, "N/A") &
                "<br />--------------------------------<br /><br />"
                ,

                ""
                )
                }

      elseActions:
        - kind: SendActivity
          id: sendActivity_Ab5uMh
          activity: There are currently no recent incidents associated with user {System.User.DisplayName}

