<?xml version="1.0" encoding="utf-8" ?>
<manifest>
  <control namespace="PowerCAT" constructor="ChatBot" version="0.1.69" display-name-key="ChatBot" description-key="ChatBot description" control-type="standard" >
    <external-service-usage enabled="false">
    </external-service-usage>
    <!-- property node identifies a specific, configurable piece of data that the control expects from CDS -->
    <property name="UserQuery" display-name-key="User Query" description-key="User Query" of-type="SingleLine.Text" usage="input" required="true" />
    <property name="DefaultActivities" display-name-key="Default Activities" description-key="JSON string containing conversation transcript activities" of-type="Multiple" usage="input" required="false" />
    <property name="TokenEndpoint" display-name-key="Token Endpoint" description-key="Token Endpoint for Agent" of-type="SingleLine.Text" usage="input" required="false" />
    <property name="StyleOptions" display-name-key="Style Options" description-key="JSON string containing style options for control" of-type="Multiple" usage="input" required="false" />
    <property name="FluentTheme" display-name-key="Fluent Theme" description-key="Flag to enable fluent theme for control" of-type="TwoOptions" usage="input" required="true" default-value="false" />
    <property name="ResetConversation" display-name-key="Reset Conversation" description-key="Flag to reset conversation" of-type="TwoOptions" usage="input" required="false" default-value="false" />
    <property name="Error" display-name-key="Error" description-key="Error message" of-type="SingleLine.Text" usage="output" required="false" />
    <resources>
      <code path="index.ts" order="1"/>
      <css path="./Components/css/BotControl.css" order="1" />
    </resources>
  </control>
</manifest>
