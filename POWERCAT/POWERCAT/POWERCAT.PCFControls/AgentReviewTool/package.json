{
  "name": "pcf-project",
  "version": "1.0.0",
  "description": "Project containing your PowerApps Component Framework (PCF) control.",
  "sideEffects": [
    "*.css",
    "*.scss"
  ],
  "scripts": {
    "build": "pcf-scripts build",
    "clean": "pcf-scripts clean",
    "lint": "pcf-scripts lint",
    "lint:fix": "pcf-scripts lint fix",
    "rebuild": "pcf-scripts rebuild",
    "start": "pcf-scripts start",
    "start:watch": "pcf-scripts start watch",
    "refreshTypes": "pcf-scripts refreshTypes",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage --coverageThreshold='{\"global\":{\"lines\":80}}'",
    "type-check": "tsc --noEmit",
    "format": "prettier --write \"**/*.{ts,tsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,json,md}\"",
    "validate": "npm run lint && npm run type-check && npm test"
  },
  "dependencies": {
    "@fluentui/react-badge": "^9.4.11",
    "@fluentui/react-button": "^9.6.12",
    "@fluentui/react-components": "^9.54.0",
    "@fluentui/react-dialog": "^9.16.3",
    "@fluentui/react-provider": "^9.22.11",
    "@fluentui/react-search": "^9.3.11",
    "@fluentui/react-spinner": "^9.7.11",
    "@fluentui/react-table": "^9.19.5",
    "@fluentui/react-tabs": "^9.10.7",
    "@fluentui/react-teaching-popover": "^9.6.12",
    "@fluentui/react-theme": "^9.2.0",
    "@fluentui/react-tooltip": "^9.8.11",
    "chart.js": "^4.5.1",
    "js-yaml": "^4.1.1",
    "jspdf": "^3.0.4",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.25.1",
    "@microsoft/eslint-plugin-power-apps": "^0.2.51",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/chart.js": "^2.9.41",
    "@types/jest": "^30.0.0",
    "@types/js-yaml": "^4.0.9",
    "@types/powerapps-component-framework": "^1.3.16",
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.1",
    "eslint-plugin-promise": "^7.1.0",
    "eslint-plugin-react": "^7.37.2",
    "globals": "^15.15.0",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^30.2.0",
    "jest-environment-jsdom": "^30.2.0",
    "pcf-scripts": "^1",
    "pcf-start": "^1",
    "prettier": "^3.7.2",
    "ts-jest": "^29.4.5",
    "typescript": "^5.8.3",
    "typescript-eslint": "8.44.0"
  }
}
