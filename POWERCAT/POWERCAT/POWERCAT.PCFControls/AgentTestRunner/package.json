{
  "name": "pcf-project",
  "version": "1.0.0",
  "description": "Project containing your PowerApps Component Framework (PCF) control.",
  "sideEffects": false,
  "scripts": {
    "build": "pcf-scripts build --webpack-config webpack.config.js",
    "build:fresh": "npm install && npm run clean && npm run build",
    "build:production": "npm run lint && npm run build",
    "clean": "pcf-scripts clean",
    "lint": "pcf-scripts lint",
    "lint:fix": "pcf-scripts lint fix",
    "rebuild": "pcf-scripts rebuild",
    "start": "pcf-scripts start",
    "start:watch": "pcf-scripts start watch",
    "refreshTypes": "pcf-scripts refreshTypes",
    "postbuild": "echo ✅ Build completed successfully!",
    "help:deploy": "echo. && echo 📋 Deployment Steps: && echo. && echo 1. pac solution init --publisher-name YourPublisher --publisher-prefix prefix && echo 2. pac solution add-reference --path . && echo 3. pac solution build && echo 4. pac solution import --path bin/debug/YourSolution.zip && echo."
  },
  "dependencies": {
    "@azure/msal-browser": "^3.28.1",
    "@fluentui/react-charting": "^5.24.20",
    "@fluentui/react-components": "^9.67.0",
    "@fluentui/react-icons": "^2.0.306",
    "@microsoft/agents-activity": "^1.0.15",
    "@microsoft/agents-copilotstudio-client": "^1.0.15",
    "buffer": "^6.0.3",
    "crypto-browserify": "^3.12.0",
    "jszip": "^3.10.1",
    "os-browserify": "^0.3.0",
    "path-browserify": "^1.0.1",
    "process": "^0.11.10",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "stream-browserify": "^3.0.0",
    "util": "^0.12.5"
  },
  "devDependencies": {
    "@babel/core": "^7.27.7",
    "@babel/preset-env": "^7.27.2",
    "@eslint/js": "^9.25.1",
    "@microsoft/eslint-plugin-power-apps": "^0.2.51",
    "@types/node": "^18.19.86",
    "@types/powerapps-component-framework": "^1.3.16",
    "@types/react": "^18.3.23",
    "@types/react-dom": "^18.3.7",
    "babel-loader": "^10.0.0",
    "eslint-plugin-promise": "^7.1.0",
    "globals": "^15.15.0",
    "pcf-scripts": "^1",
    "pcf-start": "^1",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.31.0",
    "webpack": "^5.95.0",
    "webpack-merge": "^6.0.1"
  }
}
